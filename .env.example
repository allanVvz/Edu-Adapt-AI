# Database
POSTGRES_DB=eduadapt
POSTGRES_USER=eduadapt
POSTGRES_PASSWORD=eduadapt
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eduadapt:eduadapt@postgres:5432/eduadapt

# Auth
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
# Regex para aceitar subdomínios da Vercel — substituir por URL exata em produção
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Frontend
# Em produção: URL pública do backend (ex: ngrok, Cloudflare Tunnel, VPS)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Storage (future)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000

# Redis (future)
REDIS_URL=redis://redis:6379/0
