# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_DB=eduadapt
POSTGRES_USER=eduadapt
POSTGRES_PASSWORD=troque-por-senha-forte

# ── FastAPI ────────────────────────────────────────────────────
SECRET_KEY=troque-por-chave-aleatoria-de-64-chars
OPENAI_API_KEY=sk-...

# URL pública onde o backend está acessível (sem barra no final)
API_BASE_URL=https://seu-backend.railway.app

# ── CORS ───────────────────────────────────────────────────────
# Domínio de produção da Vercel (sem barra no final)
CORS_ORIGINS=https://seu-dominio.vercel.app,http://localhost:3000
CORS_ORIGIN_REGEX=https://web-[a-z0-9]+-allanulise027-3939s-projects\.vercel\.app
