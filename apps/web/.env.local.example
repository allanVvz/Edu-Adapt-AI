# ──────────────────────────────────────────────────────────────
# EduAdapt AI — Frontend environment variables
# Copie para .env.local para desenvolvimento local
# ──────────────────────────────────────────────────────────────

# URL pública do backend FastAPI
# Desenvolvimento local (Docker):
NEXT_PUBLIC_API_URL=http://localhost:8000

# Produção / Vercel preview:
# Defina essa variável nas Environment Variables do projeto na Vercel
# (Project Settings → Environment Variables)
# apontando para a URL pública do backend deployado, por exemplo:
# NEXT_PUBLIC_API_URL=https://seu-backend.railway.app
