# ──────────────────────────────────────────────────────────────
# EduAdapt AI — Backend environment variables
# Copie para .env e preencha os valores reais
# ──────────────────────────────────────────────────────────────

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://eduadapt:eduadapt@postgres:5432/eduadapt

# JWT
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Ambiente
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000

# CORS — origens permitidas (separadas por vírgula)
# Em produção, substituir por domínio real + URL da Vercel
CORS_ORIGINS=http://localhost:3000

# CORS — regex para preview deploys da Vercel
# Descomente e ajuste quando o backend estiver publicado:
# CORS_ORIGIN_REGEX=https://[a-z0-9-]+-allanulise027-3939s-projects\.vercel\.app
# Para produção + preview + localhost:
# CORS_ORIGIN_REGEX=https://(web-[a-z0-9]+-allanulise027-3939s-projects|seu-dominio)\.vercel\.app
