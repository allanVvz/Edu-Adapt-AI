# ──────────────────────────────────────────────────────────────
# EduAdapt AI — Backend environment variables
# Copie para .env e preencha os valores reais
# ──────────────────────────────────────────────────────────────

# ── Banco de dados ─────────────────────────────────────────────
# Local (docker-compose): usar o hostname do container
DATABASE_URL=postgresql://eduadapt:eduadapt@postgres:5432/eduadapt
# Produção (Railway/Render/Neon): usar a connection string fornecida pelo serviço
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ────────────────────────────────────────────────────────
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── OpenAI ─────────────────────────────────────────────────────
# Chave padrão usada na ausência de chave por usuário (opcional)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Ambiente ───────────────────────────────────────────────────
ENVIRONMENT=development
# Em produção: ENVIRONMENT=production

# URL pública do backend — usada para construir links de imagens e áudios gerados
# Local:
API_BASE_URL=http://localhost:8000
# Produção: URL do Railway/Render/VPS onde o backend está deployado
# API_BASE_URL=https://seu-backend.railway.app

# ── CORS ───────────────────────────────────────────────────────
# Origens permitidas (separadas por vírgula, sem espaço)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Em produção: adicionar domínio definitivo da Vercel
# CORS_ORIGINS=http://localhost:3000,https://eduadapt.vercel.app

# Regex para preview deploys da Vercel (opcional)
# Descomente quando o backend estiver publicado e a Vercel tiver o projeto conectado
# CORS_ORIGIN_REGEX=https://web-[a-z0-9]+-allanulise027-3939s-projects\.vercel\.app
